# ============================================================
# Acta de Tecnología · Levapan
# Copia este archivo como .env y completa los valores.
# .env está excluido de Git y nunca se sube al repositorio.
# En Render / Azure App Service estas variables se definen en el
# panel de "Environment Variables"; no se sube ningún .env.
# ============================================================

# --- Microsoft Entra ID (App registration) ---
# Permiso de APLICACIÓN Sites.Read.All (o Sites.ReadWrite.All)
# sobre Microsoft Graph, con consentimiento del administrador.
TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=

# --- SharePoint ---
# Formatos aceptados de SITE_ID:
#   levapan.sharepoint.com,<siteCollectionId>,<webId>
#   levapan.sharepoint.com:/sites/NombreDelSitio
SITE_ID=

# Nombre o ID de la lista que contiene el inventario.
SHAREPOINT_LIST_ID=Inventario

# --- Power Automate ---
# URL del desencadenador HTTP ("Cuando se recibe una solicitud HTTP")
# del flujo que guarda el PDF en SharePoint. Respaldo opcional si
# Graph no puede escribir directamente en la carpeta compartida.
HTTP_WEBHOOK_URL=

# --- Servidor ---
# Render inyecta PORT automáticamente; en Azure App Service puede
# definirse como 8080. En local se usa 3000.
PORT=
# Interfaz de escucha. En la nube debe ser 0.0.0.0.
HOST=0.0.0.0

# --- Modo nube / almacenamiento ---
# true: no escribe copias locales persistentes; usa os.tmpdir() y
# borra el PDF después de subirlo a SharePoint. En Linux se detecta
# automáticamente, pero conviene declararlo en Render/Azure.
CLOUD_MODE=

# Carpeta base dentro de SharePoint para las actas ("2026/11-Noviembre").
ACTA_CARPETA_BASE=Actas

# Solo Windows: carpeta local de respaldo de los PDFs.
# Por defecto C:\Actas-Levapan\Actas_Guardadas.
ACTA_DIR_LOCAL=

# --- Compatibilidad con versiones anteriores (opcional) ---
# Se aceptan como alias si no defines las variables principales.
# ACTA_CLAVE=            (solo publicar.bat: túnel Cloudflare en Windows;
#                         el servidor ya no pide contraseña)
# ACTA_PORT=3000
# SHAREPOINT_SITE_ID=
# GRAPH_LIST_ID=
# LIST_ID=
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# ACTA_DB_PATH=
# ACTA_PDF_DIR=

# ============================================================
# Acta de Tecnología · Levapan — Plataforma Supabase
# Copia este archivo como .env y completa los valores.
# .env está excluido de Git: NUNCA subas credenciales al repo.
# En Render define estas mismas variables en Environment.
# ============================================================

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

PORT=3000
HOST=0.0.0.0

# Modo nube (en Render se detecta solo por la ausencia de HOST local).
CLOUD_MODE=true

# NOTA: la aplicación ya NO usa Microsoft Entra ID, Microsoft Graph ni
# SharePoint. Las actas se guardan en el bucket privado "actas-pdf" de
# Supabase Storage y el inventario vive en la tabla "equipos" de PostgreSQL.

# ------------------------------------------------------------
# Bóveda documental (opcional)
# ------------------------------------------------------------
# Por defecto la Bóveda usa Supabase Storage (bucket privado "boveda-ti").
# No definas nada más: funciona sin costo dentro del plan gratuito.
#
# Para migrar a Backblaze B2 o Cloudflare R2 (10 GB gratuitos), instala:
#   npm install @aws-sdk/client-s3 @aws-sdk/s3-request-presigner
# y define:
#
# VAULT_PROVIDER=s3
# VAULT_BUCKET=boveda-ti
# VAULT_S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
# VAULT_S3_REGION=us-west-004
# VAULT_S3_ACCESS_KEY_ID=
# VAULT_S3_SECRET_ACCESS_KEY=
# VAULT_S3_FORCE_PATH_STYLE=true
#
# Si VAULT_PROVIDER se deja vacío o en "supabase", estas variables se ignoran.

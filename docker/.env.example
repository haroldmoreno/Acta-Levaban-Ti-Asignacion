# Copiar a docker/.env y reemplazar TODOS los valores marcados como CAMBIAR
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CAMBIAR_PASSWORD_SEGURO

# Secreto usado por GoTrue, PostgREST y Storage. Debe ser largo y aleatorio.
JWT_SECRET=CAMBIAR_JWT_SECRET_LARGO_Y_ALEATORIO

# URL pública de la PWA y de la API (Kong)
SITE_URL=http://localhost:8080
API_URL=http://localhost:8000

# Anon key pública: genera un JWT con role=anon firmado con JWT_SECRET.
# Ver el paso 5 de README-DOCKER.md.
SUPABASE_ANON_KEY=CAMBIAR_ANON_JWT

# URL del proyecto (se escribe en public/js/config.js para el despliegue on-premise)
SUPABASE_URL=http://localhost:8000
